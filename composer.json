{
    "name": "andicot/log-viewer",
    "description": "Log viewer for Laravel 12 and 13 with daily log browsing and filtering by severity. Fork of ARCANEDEV/LogViewer.",
    "keywords": [
        "arcanedev",
        "arcanesoft",
        "laravel",
        "log",
        "log viewer",
        "log-viewer",
        "logviewer"
    ],
    "authors": [
        {
            "name": "ARCANEDEV",
            "email": "arcanedev.maroc@gmail.com",
            "homepage": "https://github.com/arcanedev-maroc",
            "role": "Developer"
        },
        {
            "name": "Andicot",
            "homepage": "https://github.com/Andicot",
            "role": "Maintainer"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench-core": "^10.0 || ^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Arcanedev\\LogViewer\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Arcanedev\\LogViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:dox": "phpunit --testdox --colors=always",
        "test:cov": "phpunit --coverage-html build/coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arcanedev\\LogViewer\\LogViewerServiceProvider",
                "Arcanedev\\LogViewer\\Providers\\DeferredServicesProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "arcanedev/log-viewer": "*"
    },
    "homepage": "https://github.com/Andicot/log-viewer",
    "support": {
        "issues": "https://github.com/Andicot/log-viewer/issues",
        "source": "https://github.com/Andicot/log-viewer"
    }
}
